+        # exporting the operator's coordinates and frame contents to the
+        # public SatNOGS DB without their knowledge. The example value
+        # in docs/source/command_line.rst already shows 'no'.
+        'submit_tlm': 'no',
     }
 
     config['FUNcube'] = {
